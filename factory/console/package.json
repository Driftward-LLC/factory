{
  "name": "@driftward/factory-console",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --ci --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "pack:ui": "npm pack --workspace @driftward/ui --pack-destination /tmp",
    "check:ui": "tsc --noEmit --strict --jsx react-jsx --module nodenext --target es2022 ui/index.tsx"
  },
  "dependencies": {
    "@driftward/ui": "0.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-mcp": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "storybook": "10.6.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "workspaces": [
    "ui"
  ]
}
