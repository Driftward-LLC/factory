  else
    unit_status "Hatchet control plane" driftward-hatchet.service required
    unit_status "Hatchet Hermes gRPC gateway" driftward-hatchet-hermes-gateway.service required
    unit_status "Hatchet bridge API" driftward-hatchet-bridge.service required
    unit_status "Hatchet event ingress" driftward-hatchet-event-ingress.service required
    unit_status "Hatchet Linear webhook proxy" driftward-hatchet-linear-webhook-proxy.service required
    unit_status "Hatchet intake worker" driftward-hatchet-worker-intake.service required
    unit_status "Hatchet execution-dispatch worker" driftward-hatchet-worker-execution-dispatch.service required
    unit_status "Hatchet bridge-executor worker" driftward-hatchet-worker-bridge-executor.service required
    unit_status "Hatchet PR-event worker" driftward-hatchet-worker-pr-event.service required
