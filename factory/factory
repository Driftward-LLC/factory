    all)
      printf '%s\n' \
        event-ingress \
        intake-worker \
        bridge-executor-worker \
        pr-event-worker \
        reconciliation-worker \
        bridge \
        factory-lifecycle-writer \
        factory-linear-token-refresh \
        factory-operator \
        outbox-dispatcher
      ;;
    ingress)
      printf '%s\n' event-ingress
      ;;
    intake)
      printf '%s\n' intake-worker
      ;;
    executor)
      printf '%s\n' bridge-executor-worker
      ;;
    bridge)
      printf '%s\n' bridge
      ;;
    pr)
      printf '%s\n' pr-event-worker
      ;;
    reconciliation)
      printf '%s\n' reconciliation-worker
      ;;
    lifecycle)
      printf '%s\n' \
