restart_intake() {
  if factory_docker_runtime_active; then
    docker_compose up -d --force-recreate --no-deps intake-worker >/dev/null
  else
    systemctl restart "$INTAKE_SERVICE"
  fi
}

set_mode() {
  local mode="$1"
  local confirmed="${2:-}"

  require_root
  case "$mode" in
    dry-run)
      upsert_env HATCHET_INTAKE_DRY_RUN true
      upsert_operator_env_if_present HATCHET_INTAKE_DRY_RUN true
      restart_intake
      printf 'factory intake mode: dry-run\n'
      ;;
    real)
      if [[ "$confirmed" != "--yes" ]]; then
        die "real mode can create GitHub PRs from Ready Linear issues; rerun: factory mode real --yes"
      fi
      upsert_env HATCHET_INTAKE_DRY_RUN false
      upsert_operator_env_if_present HATCHET_INTAKE_DRY_RUN false
      restart_intake
      printf 'factory intake mode: real\n'
      ;;
    *)
      usage
      exit 2
      ;;
  esac
}

