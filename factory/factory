    "",
    "Recovery and safety",
    (.recovery.by_attempt_kind | to_entries[] | "  \(.key | words) attempts  \(.value.attempts)  verified \(.value.verified)"),
    "  Failed-attempt recovery within \(.recovery.recovery_maturity_days)d \(.recovery.failed_attempts_verified_within_horizon)/\(.recovery.age_qualified_failed_attempts)  \(.recovery.failed_attempt_recovery_rate | pct)",
    "  Recovery horizon maturity         \(.recovery.failed_attempt_recovery_outcome_coverage | cov); right-censored \(.recovery.right_censored_failed_attempts) (active-now \(.recovery.active_recovery_lineages), immature \(.recovery.immature_failed_attempts), unaged \(.recovery.unaged_unrecovered_failed_attempts))",
    "  Observed eventual recoveries      \(.recovery.failed_attempts_eventually_verified) (late beyond horizon \(.recovery.late_observed_attempt_recoveries))",
    "  Failure → retry p50             \(.recovery.failure_to_retry_reserved_ms.p50 | duration)",
    "  Failure → verified p50          \(.recovery.failure_to_verified_ready_ms.p50 | duration)",
    "  Repair budgets exhausted          \(.recovery.repair_budgets_exhausted)",
    "  Bridge submit deduplicated events  \(.safety.bridge_submit_deduplicated_events)",
    "  Unknown effect outcomes           \(.safety.unknown_effect_outcomes)",
    "  Observed receipt recovery incidents \(.safety.observed_receipt_commit_recovery_incidents)",
    "  Unresolved observed receipts        \(.safety.unresolved_observed_receipts)",
    "  Receipt recovery retries exhausted  \(.safety.observed_receipt_recovery_exhausted)",
    "  Rejected observed receipts          \(.safety.rejected_observed_receipts)",
    "  Duplicate effects                 \(if .safety.duplicate_effects_detected == null then "unavailable" else .safety.duplicate_effects_detected end)",
    "  Work items ready for review       \(.human.work_items_ready_for_review)",
    "  Exception intervention attempts  \(.human.exception_intervention_attempts)",
    "",
    "Backends",
    (if (.backends | length) == 0 then "  No attributed backend executions."
     else (.backends[] | "  \(.execution_backend)/\(.execution_transport) configured_auth=\(.configured_auth_mode)  attempts=\(.attempts) invocations=\(.invocations) completed=\(.completed_invocations) failed=\(.failed_invocations) completed_p50=\(.completed_invocation_latency_ms.p50 | duration) failed_p50=\(.failed_invocation_latency_ms.p50 | duration)") end),
    "",
    "Intent-to-treat routes",
    (if (.routes.groups | length) == 0 then "  No route assignments in this cohort."
     else (.routes.groups[] | "  \(.experiment_id)/\(.variant) \(.intended_backend)/\(.intended_transport) provider=\(.configured_provider) model=\(.configured_model) repo=\(.repository) kind=\(.attempt_kind) attempts=\(.attempts) invoked=\(.backend_invoked) verified=\(.verified_ready)") end),
    (if .routes.lineage then
