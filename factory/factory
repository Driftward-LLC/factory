      ;;
    ingress)
      printf '%s\n' driftward-hatchet-event-ingress.service
      ;;
    intake)
      printf '%s\n' driftward-hatchet-worker-intake.service
      ;;
    executor)
      printf '%s\n' driftward-hatchet-worker-bridge-executor.service
      ;;
    bridge)
      printf '%s\n' driftward-hatchet-bridge.service
      ;;
    pr)
      printf '%s\n' driftward-hatchet-worker-pr-event.service
