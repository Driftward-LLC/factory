#!/usr/bin/env bash
set -euo pipefail

ENV_FILE="${FACTORY_HATCHET_WORKERS_ENV:-/etc/driftward/hatchet-workers.env}"
INTAKE_SERVICE=driftward-hatchet-worker-intake.service
OPERATOR_ENV_FILE="${FACTORY_OPERATOR_ENV:-/etc/driftward/factory-operator.env}"
OPERATOR_SOCKET="${FACTORY_OPERATOR_SOCKET:-/run/driftward-factory-operator/operator.sock}"
BRIDGE_ENV_FILE="${FACTORY_HATCHET_BRIDGE_ENV:-/etc/driftward/hatchet-bridge.env}"
RUNTIME_ROOT="${DRIFTWARD_FACTORY_RUNTIME_ROOT:-/docker/driftward/factory}"
HATCHET_ENV_FILE="${DRIFTWARD_HATCHET_ENV_FILE:-/etc/driftward/hatchet.env}"
FACTORY_SERVICE="${DRIFTWARD_FACTORY_SYSTEMD_SERVICE:-driftward-factory.service}"
HERMES_FACTORY_GATEWAY_SERVICE="${DRIFTWARD_HERMES_FACTORY_GATEWAY_SERVICE:-driftward-hermes-factory-gateway.service}"
HERMES_FACTORY_GATEWAY_SOCKET="${DRIFTWARD_HERMES_FACTORY_GATEWAY_SOCKET:-/run/driftward-hermes-factory/hermes.sock}"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
FACTORY_SHARE_DIR="${FACTORY_SHARE_DIR:-${DRIFTWARD_FACTORY_SHARE_DIR:-/usr/local/share/driftward-factory}}"
RETIRED_FACTORY_UNITS=(
  driftward-hatchet.service
  driftward-hatchet-bridge.service
  driftward-hatchet-event-ingress.service
  driftward-hatchet-linear-webhook-proxy.service
  driftward-hatchet-worker-intake.service
  driftward-hatchet-worker-execution-dispatch.service
  driftward-hatchet-worker-bridge-executor.service
  driftward-hatchet-worker-pr-event.service
  driftward-hatchet-worker-reconciliation.service
  driftward-hatchet-hermes-gateway.service
  driftward-factory-lifecycle-writer.service
  driftward-factory-linear-token.service
  driftward-factory-linear-token.timer
  driftward-factory-operator.service
  driftward-factory-outbox-dispatcher.service
  driftward-factory-outbox-dispatcher.timer
  driftward-hatchet-bridge-reconciler.service
  driftward-hatchet-bridge-reconciler.timer
)

usage() {
  cat <<'EOF'
Usage:
  factory status
  factory console
  factory analytics [--days N] [--json]
  factory logs [target] [-f|--follow] [-n|--lines N]
  factory mode
  factory mode dry-run
  factory mode real --yes
  factory retry ENG-X preview [--supersede-pr URL] [--supersede-job JOB-ID]
  factory retry ENG-X --reason TEXT --request-id ID --snapshot-digest DIGEST [--supersede-pr URL] [--supersede-job JOB-ID] --yes
  factory retry ENG-X force-absence preview --attempt-id ATTEMPT-ID
  factory retry ENG-X force-absence --attempt-id ATTEMPT-ID --reason TEXT --request-id ID --snapshot-digest DIGEST --yes
  factory lifecycle ENG-X [--json] [--limit N]
  factory lifecycle dead-letters list [--json] [--limit N]
  factory lifecycle dead-letters preview OUTBOX-KEY
  factory lifecycle dead-letters archive OUTBOX-KEY --reason TEXT --snapshot-digest DIGEST --yes
  factory attempts active [--json]
  factory attempts list ENG-X [--json]
  factory attempts show ATTEMPT-ID
  factory attempts evidence ATTEMPT-ID
  factory attempts events ATTEMPT-ID [--json] [--limit N]
  factory attempts cancel ATTEMPT-ID --reason TEXT --yes
  factory attempts refresh-receipt ATTEMPT-ID --reason TEXT --yes
  factory attempts resolve-interrupted ATTEMPT-ID inspect --yes
  factory attempts resolve-interrupted ATTEMPT-ID preview --attestation FILE --reason TEXT
  factory attempts resolve-interrupted ATTEMPT-ID confirm --attestation FILE --reason TEXT --request-id ID --snapshot-digest DIGEST --yes
  factory doctor hatchet [--profile PROFILE | --live-json PATH] [--json] [--fail-on-warning]

Log targets:
  all, ingress, intake, executor, bridge, pr, reconciliation, lifecycle, linear, console

Modes:
  dry-run  Linear Ready events create dry-run bridge jobs.
  real     Linear Ready events create real bridge jobs. Requires --yes.
EOF
}

die() {
  printf 'factory: %s\n' "$*" >&2
  exit 1
}

source_tree_root() {
  local candidate
  candidate="$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd -P || true)"
  if [[ -n "$candidate" && -f "$candidate/tools/factory-hatchet-doctor.py" ]]; then
    printf '%s\n' "$candidate"
  fi
}

factory_hatchet_doctor_script() {
  local root
  if [[ -n "${FACTORY_HATCHET_DOCTOR_SCRIPT:-}" ]]; then
    printf '%s\n' "$FACTORY_HATCHET_DOCTOR_SCRIPT"
    return
  fi
  root="$(source_tree_root || true)"
  if [[ -n "$root" ]]; then
    printf '%s\n' "$root/tools/factory-hatchet-doctor.py"
    return
  fi
  printf '%s\n' "$FACTORY_SHARE_DIR/factory-hatchet-doctor.py"
}

factory_hatchet_desired_state() {
  local root
  if [[ -n "${FACTORY_HATCHET_DESIRED_STATE:-}" ]]; then
    printf '%s\n' "$FACTORY_HATCHET_DESIRED_STATE"
    return
  fi
  root="$(source_tree_root || true)"
  if [[ -n "$root" ]]; then
    printf '%s\n' "$root/hatchet/desired-state/factory-hatchet.json"
    return
  fi
  printf '%s\n' "$FACTORY_SHARE_DIR/desired-state/factory-hatchet.json"
}

doctor() {
  local target="${1:-}"
  shift || true
  case "$target" in
    hatchet)
      local script desired
      script="$(factory_hatchet_doctor_script)"
      desired="$(factory_hatchet_desired_state)"
      [[ -f "$script" ]] || die "missing Hatchet doctor script: $script"
      [[ -f "$desired" ]] || die "missing Hatchet desired-state manifest: $desired"
      python3 "$script" --desired "$desired" "$@"
      ;;
    *)
      die "usage: factory doctor hatchet [--profile PROFILE | --live-json PATH] [--json] [--fail-on-warning]"
      ;;
  esac
}

require_root() {
  if [[ "$(id -u)" != "0" ]]; then
    die "mode changes require root"
  fi
}

docker_compose() {
  local args=(--project-directory "$RUNTIME_ROOT")
  if [[ -r "$HATCHET_ENV_FILE" ]]; then
    args=(--env-file "$HATCHET_ENV_FILE" "${args[@]}")
  fi
  docker compose "${args[@]}" "$@"
}

factory_docker_runtime_available() {
  [[ -f "$RUNTIME_ROOT/docker-compose.yml" ]] && command -v docker >/dev/null 2>&1
}

factory_docker_runtime_active() {
  systemctl is-active --quiet "$FACTORY_SERVICE" 2>/dev/null && return 0
  factory_docker_runtime_available || return 1
  docker_compose ps --services --filter status=running 2>/dev/null | grep -qx 'hatchet-lite'
}

operator_token() {
  [[ -r "$OPERATOR_ENV_FILE" ]] || die "factory operator credentials are unavailable"
  awk -F= '$1 == "HATCHET_FACTORY_OPERATOR_TOKEN" { print $2; exit }' "$OPERATOR_ENV_FILE"
}

operator_request() {
  local method="$1" path="$2" data="${3:-}" token
  require_root
  token="$(operator_token)"
  [[ -n "$token" && -S "$OPERATOR_SOCKET" ]] || die "factory operator is unavailable"
  if [[ "$method" == "GET" ]]; then
    curl --silent --show-error --fail --unix-socket "$OPERATOR_SOCKET" -H "Authorization: Bearer $token" "http://localhost$path"
  else
    curl --silent --show-error --fail --unix-socket "$OPERATOR_SOCKET" -H "Authorization: Bearer $token" -H 'Content-Type: application/json' --data "$data" "http://localhost$path"
  fi
}

require_jq_for_view() {
  command -v jq >/dev/null 2>&1 || die "jq is required for formatted output; rerun with --json"
}

format_active_attempts() {
  require_jq_for_view
  jq -r '
    def dash: if . == null or . == "" then "-" else tostring end;
    if (.attempts | length) == 0 then
      "No active factory attempts."
    else
      "Active factory attempts",
      "=======================",
      (.attempts[] |
        .attempt as $a | .job as $j | .execution_lease as $l |
        ((($j // {}).pr_url // $a.prior_pr_url) | dash) as $pr |
        "",
        "\($a.work_item_key) generation \($a.generation)  \($a.status)",
        "  attempt: \($a.attempt_id)",
        "  job: \((($j // {}).job_id)|dash)  \((($j // {}).requested_action)|dash)/\((($j // {}).state)|dash)",
        "  repo: \((($j // {}).payload.repo)|dash)",
        "  branch: \($a.branch|dash)",
        "  pr: \($pr)",
        "  lease: \(if $l == null then "none" else "\($l.status) expires=\($l.expires_at|dash)" end)"
      )
    end
  '
}

format_attempt_events() {
  require_jq_for_view
  jq -r '
    if (.events | length) == 0 then
      "No factory attempt events."
    else
      "Factory attempt events",
      "======================",
      (.events[] | "  \(.created_at)  \(.event_type)  \(.details | tojson)")
    end
  '
}

format_analytics() {
  require_jq_for_view
  jq -r '
    def pct: if . == null then "-" else "\((. * 1000 | round) / 10)%" end;
    def cov: if . == null then "-" else "\(.observed)/\(.eligible)  \(.rate | pct)" end;
    def value: if . == null then "unavailable" else tostring end;
    def words: gsub("_"; " ");
    def duration:
      if . == null then "-"
      elif . < 1000 then "\(. | round)ms"
      elif . < 60000 then "\(((. / 1000) * 10 | round) / 10)s"
      elif . < 3600000 then "\(((. / 60000) * 10 | round) / 10)m"
      else "\(((. / 3600000) * 10 | round) / 10)h" end;
    "Factory analytics — attempts created in the last \(.window.days) days",
    "Generated \(.generated_at)",
    "",
    "Coverage",
    "  Work items                       \(.coverage.cohort_work_items)",
    "  Attempts                         \(.coverage.cohort_attempts)",
    "  Execution claimed                \(.coverage.execution_claimed_attempts)",
    "  Effect authorized                \(.coverage.effect_authorized_attempts)",
    "  Backend attributed               \(.coverage.backend_attribution.observed)/\(.coverage.backend_attribution.eligible)  \(.coverage.backend_attribution.rate | pct)",
    "  Route assigned                   \(.coverage.execution_route_assignment | cov)",
    "  Configured auth labels known     \(.coverage.configured_auth_label.observed)/\(.coverage.configured_auth_label.eligible)  \(.coverage.configured_auth_label.rate | pct)",
    "  Attempt failures attributed      \(.coverage.attempt_failure_attribution.observed)/\(.coverage.attempt_failure_attribution.eligible)  \(.coverage.attempt_failure_attribution.rate | pct)",
    "",
    "Intake",
    (if .intake.available then
      "  Linear events \(.intake.linear_events)  eligible work items \(.intake.eligible_work_items)  rejected \(.intake.rejected_events)",
      "  Published \(.intake.published_events)  unpublished \(.intake.unpublished_events)",
      "  Raw repeated Ready observations \(.intake.repeated_eligible_events) (all eligible events)",
      "  Eligible receipt authenticity   \(.intake.eligible_event_authenticity | cov)",
      (if .intake.correlation.available then
        "  Authenticated repeated Ready rate \(.intake.authenticated_repeated_eligible_events)/\(.intake.authenticated_eligible_events)  \(.intake.repeated_eligible_event_rate | pct)",
        "  Eligible → real attempt         \(.intake.correlation.eligible_to_real_attempt | cov)",
        (if .intake.correlation.work_item_conversion then
          "  Ready work items: attempt \(.intake.correlation.work_item_conversion.all.real_attempt | cov), PR \(.intake.correlation.work_item_conversion.all.draft_pr_available | cov), verified \(.intake.correlation.work_item_conversion.all.verified_ready | cov), merged \(.intake.correlation.work_item_conversion.all.merged | cov)",
          "  Ready merge outcomes settled  \(.intake.correlation.work_item_conversion.all.merge_outcome_evidence | cov); right-censored \(.intake.correlation.work_item_conversion.all.right_censored_work_items)"
         else empty end),
        "  Active-attempt reuse rate      \(.intake.correlation.active_attempt_reuse_events)/\(.intake.correlation.eligible_to_real_attempt.eligible)  \(.intake.correlation.active_attempt_reuse_rate | pct)"
       else "  Authenticated Ready correlation unavailable." end),
      (if .intake.receipts.available then
        "  Webhook receipts \(.intake.receipts.receipts)  signature verified \(.intake.receipts.signature_verified_receipts | value)  unverified \(.intake.receipts.unverified_receipts | value)",
        "  Receipt coverage                \(.intake.receipts.event_receipt_coverage | cov)",
        (if .intake.receipts.full_window_rate_available then
          "  Full-window redelivery rate     \(.intake.receipts.redelivery_rate | pct)"
         else "  Observed-receipt redelivery     \(.intake.receipts.observed_receipt_redelivery_rate | pct) (conditional; full-window rate unavailable)" end)
       else "  Webhook receipt audit unavailable." end),
      "  Current publication backlog     \(.intake.publication.current_backlog | value)"
     else "  Intake ledger unavailable." end),
    "",
    "Delivery funnel (unique work items)",
    (["attempted", "executor_started", "effect_committed", "draft_pr_available", "verified_ready"][] as $stage |
      "  \($stage | words)  \(.funnel.stages[$stage].count)  \(.funnel.stages[$stage].rate_from_attempted | pct)"),
    "",
    "Attempt status (attempt grain)",
    (.outcomes.by_status | to_entries[] | "  \(.key | words)  \(.value)"),
    (if .outcomes.right_censored then
      "  Note: \(.outcomes.active_attempts) cohort attempt(s) are still active; outcome rates are right-censored."
     else "  All cohort attempts are terminal." end),
    (if .github.authenticated_outcomes_available == false or .outcomes.github_observation_coverage == null then
      "  GitHub outcomes unavailable."
     else
      "  GitHub PR outcomes observed \(.outcomes.github_observation_coverage.observed)/\(.outcomes.github_observation_coverage.eligible)  open \(.outcomes.open_prs | value)  merged \(.outcomes.merged_prs | value)  closed unmerged \(.outcomes.closed_unmerged_prs | value)  unobserved \(.outcomes.unobserved_prs | value)",
      "  Provider-timed merges            \(.github.merge_timestamp_coverage | cov) (required for temporal attribution)",
      "  Closed-unmerged / terminal PRs  \(.github.closed_unmerged_rates.terminal_prs.numerator)/\(.github.closed_unmerged_rates.terminal_prs.denominator)  \(.github.closed_unmerged_rates.terminal_prs.rate | pct); all-eligible lower bound \(.github.closed_unmerged_rates.all_eligible_prs.rate | pct), censored \(.github.closed_unmerged_rates.all_eligible_prs.right_censored)",
      "  Authenticated GitHub observations \(.github.authenticity.authenticated_observations | value)  unverified matching \(.github.authenticity.unverified_matching_observations | value)",
      (if .github.first_pass_checks.available then
        "  First-pass CI                    \(.github.first_pass_checks.success_rate | pct)"
       else "  First-pass CI                    unavailable (required-check aggregate is not observed)" end),
      (if .github.reviews.available then
        "  Reviews with changes requested  \(.github.reviews.changes_requested_prs)/\(.github.reviews.coverage.observed)  \(.github.reviews.changes_requested_rate | pct)"
       else "  Review observations             unavailable" end),
      "  Mature 24h terminal coverage    \(.outcomes.maturity.at_24h.terminal_observation | cov)",
      "  Mature 7d terminal coverage     \(.outcomes.maturity.at_7d.terminal_observation | cov)"
     end),
    "",
    "Latency                                      n        p50        p95",
    (.latency_ms | to_entries[] | "  \(.key | words)  \(.value.samples)/\(.value.eligible // .value.samples)  \(.value.p50 | duration)  \(.value.p95 | duration)"),
    "",
    "Failure evidence (attempt grain)",
    "  Currently failed \(.failures.currently_failed_attempts)  with failure evidence \(.failures.attempts_with_failure_evidence)  recovered \(.failures.recovered_failure_attempts)",
    (if (.failures.by_classification | length) == 0 then "  none"
     else (.failures.by_classification[] | "  \(.failure_domain) / \(.failure_stage) / \(.reason_code)  \(.count)") end),
    "  Backend invocation failures      \(.failures.backend_invocations.failed)",
    (.failures.backend_invocations.by_classification[] | "    \(.failure_domain) / \(.failure_stage) / \(.reason_code)  \(.count)"),
    "  Dispatch boundary failures       \(.failures.dispatch_boundaries.failed)",
    (.failures.dispatch_boundaries.by_classification[] | "    \(.failure_domain) / \(.failure_stage) / \(.reason_code)  \(.count)"),
