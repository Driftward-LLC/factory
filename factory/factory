show_logs() {
  local target="all"
  local follow=0
  local lines=100
  local units=()
  local args=()

  if [[ $# -gt 0 && "$1" != -* ]]; then
    target="$1"
    shift
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--follow)
        follow=1
        shift
        ;;
      -n|--lines)
        [[ $# -ge 2 ]] || die "--lines requires a value"
        lines="$2"
        shift 2
        ;;
      *)
        die "unknown logs option: $1"
        ;;
    esac
  done

  if factory_docker_runtime_active; then
    mapfile -t units < <(docker_services_for_target "$target")
    args=(--tail="$lines")
    if [[ "$follow" == "1" ]]; then
      args+=(-f)
    fi
    docker_compose logs "${args[@]}" "${units[@]}"
  else
    mapfile -t units < <(units_for_target "$target")
    for unit in "${units[@]}"; do
      args+=(-u "$unit")
    done
    if [[ "$follow" == "1" ]]; then
      journalctl "${args[@]}" -n "$lines" -f
    else
      journalctl "${args[@]}" -n "$lines" --no-pager
    fi
  fi
}

show_console() {
  local dns url="${FACTORY_CONSOLE_URL:-}"
  curl -fsS http://127.0.0.1:19881/health >/dev/null || die "Factory console is unavailable"
  if [[ -z "$url" ]] && command -v tailscale >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    dns="$(tailscale status --json 2>/dev/null | jq -r '.Self.DNSName // empty' 2>/dev/null | sed 's/[.]$//' || true)"
    [[ -z "$dns" || "$dns" == "null" ]] || url="https://$dns:19881/"
  fi
  [[ -n "$url" ]] || die "Factory console requires a Tailscale Serve URL; set FACTORY_CONSOLE_URL for local development"
  printf '%s\n' "$url"
}

main() {
  local command="${1:-}"
  case "$command" in
    status)
      show_status
      ;;
    console)
      [[ $# -eq 1 ]] || die "usage: factory console"
      show_console
      ;;
    logs)
      shift
      show_logs "$@"
      ;;
    mode)
      shift
      if [[ $# -eq 0 || "${1:-}" == "status" ]]; then
        mode_status
      else
        set_mode "$@"
      fi
      ;;
    retry)
      shift
      [[ $# -ge 1 ]] || die "usage: factory retry ENG-X --reason TEXT --yes"
      retry_issue "$@"
      ;;
    lifecycle)
      shift
      lifecycle "$@"
      ;;
    attempts)
      shift
      attempts "$@"
      ;;
    doctor)
      shift
      doctor "$@"
      ;;
    -h|--help|help|"")
      usage
      ;;
    *)
      usage
      exit 2
      ;;
  esac
}

main "$@"
