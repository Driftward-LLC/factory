analytics() {
  local days=30 json=0 response
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --days)
        [[ $# -ge 2 ]] || die "--days requires a value"
        days="$2"
        shift 2
        ;;
      --json)
        json=1
        shift
        ;;
      *)
        die "usage: factory analytics [--days N] [--json]"
        ;;
    esac
  done
  [[ "$days" =~ ^[0-9]{1,3}$ ]] || die "analytics --days must be between 1 and 365"
  days=$((10#$days))
  (( days >= 1 && days <= 365 )) || die "analytics --days must be between 1 and 365"
  response="$(operator_request GET "/v1/analytics?days=$days")"
  if [[ "$json" == "1" ]]; then
    printf '%s\n' "$response"
  else
    format_analytics <<<"$response"
  fi
}

format_lifecycle() {
  require_jq_for_view
  jq -r '
    def dash: if . == null or . == "" then "-" else tostring end;
    "Factory lifecycle \(.work_item_key)",
    "==================",
    "",
    (if (.attempts | length) == 0 then
      "No attempts."
    else
      "Attempts:",
      (.attempts[] |
        .attempt as $a | .job as $j | .execution_lease as $l |
        ((($j // {}).pr_url // $a.prior_pr_url) | dash) as $pr |
        "  generation \($a.generation)  \($a.status)  attempt=\($a.attempt_id)",
        "    job=\((($j // {}).job_id)|dash)  \((($j // {}).requested_action)|dash)/\((($j // {}).state)|dash)",
        "    repo=\((($j // {}).payload.repo)|dash) branch=\($a.branch|dash)",
        "    pr=\($pr)",
        "    lease=\(if $l == null then "none" else "\($l.status) expires=\($l.expires_at|dash)" end)"
      )
    end),
    "",
    "Timeline:",
    (if (.timeline | length) == 0 then
      "  no lifecycle events"
    else
      (.timeline[] | "  \(.created_at)  \(.source_kind)  \(.event_type)  \(.state|dash)  attempt=\(.attempt_id|dash) job=\(.job_id|dash)")
    end),
    (if .timeline_truncated then "  ... truncated" else empty end)
  '
}

format_lifecycle_dead_letters() {
  require_jq_for_view
  jq -r '
    if (.dead_letters | length) == 0 then
      "No lifecycle dead letters."
    else
      "Lifecycle dead letters",
      "======================",
      (.dead_letters[] |
        "",
        "\(.outbox_key)",
        "  reason: \(.reason_code // "unknown")",
        "  source: \(.source_kind)  recorded=\(.source_recorded_at)",
        "  issue: \(.identifier // "-")  job=\(.job_id // "-")"
      )
    end
  '
}

github_absence_evidence() {
  local repo="$1" branch="$2" encoded_branch pr_json branch_exists api_error observed
  command -v gh >/dev/null 2>&1 || die "GitHub CLI gh is required for force-absence evidence"
  encoded_branch="$(jq -rn --arg branch "$branch" '$branch|@uri')"
  pr_json="$(gh pr list --repo "$repo" --head "$branch" --state all --json number,url,state,isDraft,headRefName,headRefOid,baseRefName,mergedAt,closedAt,title)"
  if api_error="$(gh api "repos/$repo/branches/$encoded_branch" 2>&1 >/dev/null)"; then
    branch_exists=true
  else
    if grep -Eq 'HTTP 404|Not Found' <<<"$api_error"; then
      branch_exists=false
    else
      [[ -z "$api_error" ]] || printf '%s\n' "$api_error" >&2
      die "GitHub branch absence check failed"
    fi
  fi
  observed="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  jq -cn --arg kind "github_branch_pr_absence_v1" --arg repo "$repo" --arg branch "$branch" --arg observed "$observed" --argjson branch_exists "$branch_exists" --argjson prs "$pr_json" '{kind:$kind,repository:$repo,head_branch:$branch,branch_exists:$branch_exists,pull_requests:$prs,observed_at:$observed}'
}

force_absence_retry() {
  local issue="$1"; shift
  local attempt_id="" reason="" request_id="" snapshot_digest="" yes="" preview_only=""
  if [[ "${1:-}" == "preview" ]]; then preview_only=1; shift; fi
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --attempt-id) [[ $# -ge 2 ]] || die "--attempt-id requires an attempt ID"; attempt_id="$2"; shift 2 ;;
      --reason) [[ $# -ge 2 ]] || die "--reason requires text"; reason="$2"; shift 2 ;;
      --request-id) [[ $# -ge 2 ]] || die "--request-id requires an ID"; request_id="$2"; shift 2 ;;
      --snapshot-digest) [[ $# -ge 2 ]] || die "--snapshot-digest requires the digest returned by preview"; snapshot_digest="$2"; shift 2 ;;
      --yes) yes="--yes"; shift ;;
      *) die "unknown force-absence retry option: $1" ;;
    esac
  done
  [[ -n "$attempt_id" ]] || die "force-absence retry requires --attempt-id"
  local mode probe repo branch evidence body
  mode="$(mode_status)"
  probe="$(operator_request POST /v1/retry/force-absence/preview "$(jq -cn --arg issue "$issue" --arg attempt_id "$attempt_id" --arg mode "$mode" '{issue:$issue,attempt_id:$attempt_id,mode:$mode}')")"
  repo="$(jq -r '.repository // empty' <<<"$probe")"
  branch="$(jq -r '.prior_attempt.head_branch // empty' <<<"$probe")"
  [[ -n "$repo" && -n "$branch" ]] || die "force-absence preview did not return a repository and branch"
  evidence="$(github_absence_evidence "$repo" "$branch")"
  if [[ -n "$preview_only" ]]; then
    [[ -z "$reason" && -z "$request_id" && -z "$snapshot_digest" && -z "$yes" ]] || die "force-absence preview accepts only --attempt-id"
    body="$(jq -cn --arg issue "$issue" --arg attempt_id "$attempt_id" --arg mode "$mode" --argjson absence_evidence "$evidence" '{issue:$issue,attempt_id:$attempt_id,mode:$mode,absence_evidence:$absence_evidence}')"
    operator_request POST /v1/retry/force-absence/preview "$body"
    return
  fi
  [[ "$yes" == "--yes" ]] || die "force-absence retry supersedes an unknown outcome and reserves a fresh attempt; rerun with --yes"
  [[ -n "$reason" ]] || die "force-absence retry requires --reason"
  [[ -n "$request_id" ]] || die "force-absence retry requires an explicit --request-id for idempotency"
  [[ -n "$snapshot_digest" ]] || die "force-absence retry requires --snapshot-digest from a fresh preview"
  body="$(jq -cn --arg issue "$issue" --arg attempt_id "$attempt_id" --arg mode "$mode" --arg request_id "$request_id" --arg reason "$reason" --arg snapshot_digest "$snapshot_digest" --argjson absence_evidence "$evidence" '{issue:$issue,attempt_id:$attempt_id,mode:$mode,request_id:$request_id,reason:$reason,snapshot_digest:$snapshot_digest,absence_evidence:$absence_evidence}')"
  operator_request POST /v1/retry/force-absence/reserve "$body"
}

lifecycle() {
  if [[ "${1:-}" == "dead-letters" ]]; then
    shift
    lifecycle_dead_letters "$@"
    return
  fi
  local issue="" json=0 limit=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)
        json=1
        shift
        ;;
      --limit)
        [[ $# -ge 2 ]] || die "--limit requires a value"
        limit="$2"
        shift 2
        ;;
      --*)
        die "unknown lifecycle option: $1"
        ;;
      *)
        [[ -z "$issue" ]] || die "usage: factory lifecycle ENG-X [--json] [--limit N]"
        issue="$1"
        shift
        ;;
    esac
  done
  [[ -n "$issue" ]] || die "usage: factory lifecycle ENG-X [--json] [--limit N]"
  local path="/v1/lifecycle/work-item/$issue" response
  if [[ -n "$limit" ]]; then
    path="$path?limit=$limit"
  fi
  response="$(operator_request GET "$path")"
  if [[ "$json" == "1" ]]; then
    printf '%s\n' "$response"
  else
    format_lifecycle <<<"$response"
  fi
}

lifecycle_dead_letters() {
  local action="${1:-}"
  shift || true
  case "$action" in
    list)
      local json=0 limit="" path response
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --json) json=1; shift ;;
          --limit) [[ $# -ge 2 ]] || die "--limit requires a value"; limit="$2"; shift 2 ;;
          *) die "usage: factory lifecycle dead-letters list [--json] [--limit N]" ;;
        esac
      done
      path="/v1/lifecycle/dead-letters"
      [[ -z "$limit" ]] || path="$path?limit=$limit"
      response="$(operator_request GET "$path")"
      if [[ "$json" == "1" ]]; then printf '%s\n' "$response"; else format_lifecycle_dead_letters <<<"$response"; fi
      ;;
    preview)
      [[ $# -eq 1 ]] || die "usage: factory lifecycle dead-letters preview OUTBOX-KEY"
      operator_request POST /v1/lifecycle/dead-letters/archive/preview "$(jq -cn --arg outbox_key "$1" '{outbox_key:$outbox_key}')"
      ;;
    archive)
      local outbox_key="${1:-}" reason="" snapshot_digest="" yes=""
      [[ -n "$outbox_key" ]] || die "usage: factory lifecycle dead-letters archive OUTBOX-KEY --reason TEXT --snapshot-digest DIGEST --yes"
      shift || true
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --reason) [[ $# -ge 2 ]] || die "--reason requires text"; reason="$2"; shift 2 ;;
          --snapshot-digest) [[ $# -ge 2 ]] || die "--snapshot-digest requires the digest returned by preview"; snapshot_digest="$2"; shift 2 ;;
          --yes) yes="--yes"; shift ;;
          *) die "unknown lifecycle archive option: $1" ;;
        esac
      done
      [[ "$yes" == "--yes" ]] || die "lifecycle dead-letter archive requires reviewed approval; rerun with --yes"
      [[ -n "$reason" ]] || die "lifecycle dead-letter archive requires --reason"
      [[ -n "$snapshot_digest" ]] || die "lifecycle dead-letter archive requires --snapshot-digest from a fresh preview"
      operator_request POST /v1/lifecycle/dead-letters/archive "$(jq -cn --arg outbox_key "$outbox_key" --arg reason "$reason" --arg snapshot_digest "$snapshot_digest" '{outbox_key:$outbox_key,reason:$reason,snapshot_digest:$snapshot_digest}')"
      ;;
    *) die "usage: factory lifecycle dead-letters {list|preview|archive}" ;;
  esac
}

retry_issue() {
  local issue="$1"; shift
  if [[ "${1:-}" == "force-absence" ]]; then
    shift
    force_absence_retry "$issue" "$@"
    return
  fi
  local reason="" request_id="" snapshot_digest="" supersede="" supersede_job="" yes="" mode
  local preview_only=""
  mode="$(mode_status)"
  if [[ "${1:-}" == "preview" ]]; then preview_only=1; shift; fi
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --reason) [[ $# -ge 2 ]] || die "--reason requires text"; reason="$2"; shift 2 ;;
      --request-id) [[ $# -ge 2 ]] || die "--request-id requires an ID"; request_id="$2"; shift 2 ;;
      --snapshot-digest) [[ $# -ge 2 ]] || die "--snapshot-digest requires the digest returned by preview"; snapshot_digest="$2"; shift 2 ;;
      --supersede-pr) [[ $# -ge 2 ]] || die "--supersede-pr requires an exact GitHub PR URL"; supersede="$2"; shift 2 ;;
      --supersede-job) [[ $# -ge 2 ]] || die "--supersede-job requires a bridge job ID"; supersede_job="$2"; shift 2 ;;
      --yes) yes="--yes"; shift ;;
      *) die "unknown retry option: $1" ;;
    esac
  done
  if [[ -n "$preview_only" ]]; then
    [[ -z "$reason" && -z "$yes" ]] || die "preview accepts only --supersede-pr and --supersede-job"
    local preview_body
    preview_body="$(jq -cn --arg issue "$issue" --arg mode "$mode" --arg supersede "$supersede" --arg supersede_job "$supersede_job" '{issue:$issue,mode:$mode} + (if $supersede == "" then {} else {supersede_pr_url:$supersede} end) + (if $supersede_job == "" then {} else {supersede_job_id:$supersede_job} end)')"
    operator_request POST /v1/retry/preview "$preview_body"
    return
  fi
  [[ "$yes" == "--yes" ]] || die "retry reserves a fresh attempt and may create one draft PR; rerun with --yes"
  [[ -n "$reason" ]] || die "retry requires --reason"
  [[ -n "$request_id" ]] || die "retry requires an explicit --request-id for idempotency"
  [[ -n "$snapshot_digest" ]] || die "retry requires --snapshot-digest from a fresh preview"
  local body
  body="$(jq -cn --arg issue "$issue" --arg mode "$mode" --arg request_id "$request_id" --arg reason "$reason" --arg snapshot_digest "$snapshot_digest" --arg supersede "$supersede" --arg supersede_job "$supersede_job" '{issue:$issue,mode:$mode,request_id:$request_id,reason:$reason,snapshot_digest:$snapshot_digest} + (if $supersede == "" then {} else {supersede_pr_url:$supersede} end) + (if $supersede_job == "" then {} else {supersede_job_id:$supersede_job} end)')"
  operator_request POST /v1/retry/reserve "$body"
}

attempts() {
  local subcommand="${1:-}"; shift || true
  case "$subcommand" in
    active)
      local json=0 response
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --json)
            json=1
            shift
            ;;
          *)
            die "usage: factory attempts active [--json]"
            ;;
        esac
      done
      response="$(operator_request GET "/v1/attempts/active")"
      if [[ "$json" == "1" ]]; then
        printf '%s\n' "$response"
      else
        format_active_attempts <<<"$response"
      fi
      ;;
    list)
      local issue=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --json)
            shift
            ;;
          --*)
            die "unknown attempts list option: $1"
            ;;
          *)
            [[ -z "$issue" ]] || die "usage: factory attempts list ENG-X [--json]"
            issue="$1"
            shift
            ;;
        esac
      done
      [[ -n "$issue" ]] || die "usage: factory attempts list ENG-X [--json]"
      operator_request GET "/v1/attempts/work-item/$issue"
      ;;
    show) [[ $# -eq 1 ]] || die "usage: factory attempts show ATTEMPT-ID"; operator_request GET "/v1/attempts/$1" ;;
    evidence) [[ $# -eq 1 ]] || die "usage: factory attempts evidence ATTEMPT-ID"; operator_request GET "/v1/attempts/$1/evidence" ;;
    events)
      local id="" json=0 limit="" path response
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --json)
            json=1
            shift
            ;;
          --limit)
            [[ $# -ge 2 ]] || die "--limit requires a value"
            limit="$2"
            shift 2
            ;;
          --*)
            die "unknown attempts events option: $1"
            ;;
          *)
            [[ -z "$id" ]] || die "usage: factory attempts events ATTEMPT-ID [--json] [--limit N]"
            id="$1"
            shift
            ;;
        esac
      done
      [[ -n "$id" ]] || die "usage: factory attempts events ATTEMPT-ID [--json] [--limit N]"
      path="/v1/attempts/$id/events"
      if [[ -n "$limit" ]]; then
        path="$path?limit=$limit"
      fi
      response="$(operator_request GET "$path")"
      if [[ "$json" == "1" ]]; then
        printf '%s\n' "$response"
      else
        format_attempt_events <<<"$response"
      fi
      ;;
    cancel)
      local id="${1:-}"; shift || true; local reason="" yes=""
      [[ -n "$id" ]] || die "usage: factory attempts cancel ATTEMPT-ID --reason TEXT --yes"
      while [[ $# -gt 0 ]]; do case "$1" in --reason) [[ $# -ge 2 ]] || die "--reason requires text"; reason="$2"; shift 2 ;; --yes) yes="--yes"; shift ;; *) die "unknown cancellation option: $1" ;; esac; done
      [[ -n "$reason" && "$yes" == "--yes" ]] || die "cancellation requires --reason and --yes; it never closes or deletes a PR"
      operator_request POST "/v1/attempts/$id/cancel" "$(jq -cn --arg reason "$reason" '{reason:$reason}')"
      ;;
    refresh-receipt)
      local id="${1:-}"; shift || true; local reason="" yes=""
      [[ -n "$id" ]] || die "usage: factory attempts refresh-receipt ATTEMPT-ID --reason TEXT --yes"
      while [[ $# -gt 0 ]]; do case "$1" in --reason) [[ $# -ge 2 ]] || die "--reason requires text"; reason="$2"; shift 2 ;; --yes) yes="--yes"; shift ;; *) die "unknown receipt refresh option: $1" ;; esac; done
      [[ -n "$reason" && "$yes" == "--yes" ]] || die "receipt refresh requires --reason and --yes; it performs one read-only PR inspection and never invokes the execution backend"
      operator_request POST "/v1/attempts/$id/receipt-recovery/refresh" "$(jq -cn --arg reason "$reason" '{reason:$reason}')"
      ;;
    resolve-interrupted)
      local id="${1:-}" phase="${2:-}"; shift 2 || die "resolve-interrupted requires ATTEMPT-ID and inspect, preview, or confirm"
      local reason="" attestation="" request_id="" snapshot_digest="" yes=0 body
      [[ "$id" =~ ^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$ ]] || die "resolve-interrupted requires a canonical attempt UUID"
      [[ "$phase" == inspect || "$phase" == preview || "$phase" == confirm ]] || die "resolve-interrupted requires inspect, preview, or confirm"
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --reason) [[ $# -ge 2 ]] || die "--reason requires text"; reason="$2"; shift 2 ;;
          --attestation) [[ $# -ge 2 ]] || die "--attestation requires a file"; attestation="$2"; shift 2 ;;
          --request-id) [[ $# -ge 2 ]] || die "--request-id requires an ID"; request_id="$2"; shift 2 ;;
          --snapshot-digest) [[ $# -ge 2 ]] || die "--snapshot-digest requires the preview digest"; snapshot_digest="$2"; shift 2 ;;
          --yes) yes=1; shift ;;
          *) die "unknown interrupted resolution option: $1" ;;
        esac
      done
      if [[ "$phase" == inspect ]]; then
        [[ "$yes" == 1 && -z "$reason$attestation$request_id$snapshot_digest" ]] || die "inspect requires only --yes; it queues a read-only PR inspection"
        body='{}'
      else
        [[ -n "$reason" && -n "$attestation" ]] || die "resolution requires --attestation and --reason"
        [[ -f "$attestation" && ! -L "$attestation" ]] || die "attestation must be a regular file, not a symlink"
        [[ $(stat -c '%u:%a' "$attestation") == 0:600 && $(stat -c '%s' "$attestation") -le 4096 ]] || die "attestation must be root-owned, mode 0600, at most 4096 bytes"
        body="$(jq -cen --slurpfile evidence "$attestation" --arg reason "$reason" 'if ($evidence|length)==1 and ($evidence[0]|type)=="object" then {attestation:$evidence[0],reason:$reason} else error("expected one attestation object") end')"
        if [[ "$phase" == confirm ]]; then
          [[ "$yes" == 1 && -n "$request_id" && -n "$snapshot_digest" ]] || die "confirm requires --request-id, --snapshot-digest and --yes"
          body="$(jq -c --arg request_id "$request_id" --arg snapshot_digest "$snapshot_digest" '. + {request_id:$request_id,snapshot_digest:$snapshot_digest}' <<<"$body")"
        else
          [[ "$yes" == 0 && -z "$request_id$snapshot_digest" ]] || die "preview does not accept confirmation flags"
        fi
      fi
      operator_request POST "/v1/attempts/$id/interrupted-resolution/$phase" "$body"
      ;;
    *) die "usage: factory attempts {active|list|show|events|evidence|cancel|refresh-receipt|resolve-interrupted}" ;;
  esac
}

env_value() {
  env_file_value "$ENV_FILE" "$1"
}

env_file_value() {
  local file="$1"
  local key="$2"
  if [[ -f "$file" ]]; then
    awk -F= -v key="$key" '$1 == key { value = substr($0, length(key) + 2) } END { if (value != "") print value }' "$file"
  fi
}

upsert_env() {
  upsert_env_file "$ENV_FILE" "$1" "$2"
}

upsert_operator_env_if_present() {
  [[ -e "$OPERATOR_ENV_FILE" ]] || return 0
  upsert_env_file "$OPERATOR_ENV_FILE" "$1" "$2"
}

upsert_env_file() {
  local file="$1"
  local key="$2"
  local value="$3"
  local tmp

  install -d -m 0755 -o root -g root "$(dirname "$file")"
  if [[ ! -e "$file" ]]; then
    install -m 0600 -o root -g root /dev/null "$file"
  fi

  tmp="$(mktemp)"
  if [[ -s "$file" ]]; then
    awk -F= -v key="$key" '$1 != key { print }' "$file" >"$tmp"
  fi
  printf '%s=%s\n' "$key" "$value" >>"$tmp"
  install -m 0600 -o root -g root "$tmp" "$file"
  rm -f "$tmp"
}

mode_status() {
  local value
  value="$(env_value HATCHET_INTAKE_DRY_RUN || true)"
  if [[ "$value" == "false" ]]; then
    printf 'real\n'
  else
    printf 'dry-run\n'
  fi
}

status_result=0

status_line() {
  local level="$1"
  local name="$2"
  local detail="${3:-}"
  printf '%-5s %-42s %s\n' "$level" "$name" "$detail"
}

mark_failure() {
  status_result=1
}

unit_status() {
  local label="$1"
  local unit="$2"
  local required="${3:-required}"
  local active enabled detail

  active="$(systemctl is-active "$unit" 2>/dev/null || true)"
  enabled="$(systemctl is-enabled "$unit" 2>/dev/null || true)"
  detail="active=${active:-unknown} enabled=${enabled:-unknown}"

  if [[ "$active" == "active" ]]; then
    status_line OK "$label" "$detail"
  elif [[ "$required" == "required" ]]; then
    status_line FAIL "$label" "$detail"
    mark_failure
  else
    status_line WARN "$label" "$detail"
  fi
}

oneshot_status() {
  local label="$1"
  local unit="$2"
  local required="${3:-required}"
  local active failed enabled detail

  active="$(systemctl is-active "$unit" 2>/dev/null || true)"
  failed="$(systemctl is-failed "$unit" 2>/dev/null || true)"
  enabled="$(systemctl is-enabled "$unit" 2>/dev/null || true)"
  detail="active=${active:-unknown} failed=${failed:-unknown} enabled=${enabled:-unknown}"

  if [[ "$failed" != "failed" && ( "$active" == "active" || "$active" == "inactive" ) ]]; then
    status_line OK "$label" "$detail"
  elif [[ "$required" == "required" ]]; then
    status_line FAIL "$label" "$detail"
    mark_failure
  else
    status_line WARN "$label" "$detail"
  fi
}

timer_status() {
  local label="$1"
  local timer="$2"
  local required="${3:-required}"
  local active enabled next detail

  active="$(systemctl is-active "$timer" 2>/dev/null || true)"
  enabled="$(systemctl is-enabled "$timer" 2>/dev/null || true)"
  next="$(systemctl list-timers "$timer" --no-pager --no-legend 2>/dev/null | awk '{ print $1" "$2" "$3" "$4 }' || true)"
  detail="active=${active:-unknown} enabled=${enabled:-unknown}"
  [[ -z "$next" ]] || detail="$detail next=\"$next\""

  if [[ "$active" == "active" ]]; then
    status_line OK "$label" "$detail"
  elif [[ "$required" == "required" ]]; then
    status_line FAIL "$label" "$detail"
    mark_failure
  else
    status_line WARN "$label" "$detail"
  fi
}

retired_timer_status() {
  local label="$1"
  local timer="$2"
  local service="${3:-}"
  local active enabled service_active detail

  active="$(systemctl is-active "$timer" 2>/dev/null || true)"
  enabled="$(systemctl is-enabled "$timer" 2>/dev/null || true)"
  service_active=""
  [[ -z "$service" ]] || service_active="$(systemctl is-active "$service" 2>/dev/null || true)"
  detail="timer_active=${active:-unknown} timer_enabled=${enabled:-unknown}"
  [[ -z "$service" ]] || detail="$detail service_active=${service_active:-unknown}"

  if [[ "$active" != "active" && "$enabled" != "enabled" && "$enabled" != "enabled-runtime" && ( -z "$service" || "$service_active" != "active" ) ]]; then
    status_line OK "$label" "$detail"
  else
    status_line WARN "$label" "$detail"
  fi
}

retired_factory_units_status() {
  local unit active enabled offenders=""
  for unit in "${RETIRED_FACTORY_UNITS[@]}"; do
    active="$(systemctl is-active "$unit" 2>/dev/null || true)"
    enabled="$(systemctl is-enabled "$unit" 2>/dev/null || true)"
    if [[ "$active" == "active" || "$enabled" == "enabled" || "$enabled" == "enabled-runtime" ]]; then
      offenders="${offenders:+$offenders,}$unit(active=${active:-unknown},enabled=${enabled:-unknown})"
    fi
  done
  if [[ -z "$offenders" ]]; then
    status_line OK "Retired direct-host Factory units" "inactive and disabled"
  else
    status_line FAIL "Retired direct-host Factory units" "$offenders"
    mark_failure
  fi
}

docker_service_status() {
  local label="$1"
  local service="$2"
  local required="${3:-required}"
  local cid inspection state oom restarts health image detail

  if ! factory_docker_runtime_available; then
    detail="missing compose runtime: $RUNTIME_ROOT/docker-compose.yml"
    if [[ "$required" == "required" ]]; then
      status_line FAIL "$label" "$detail"
      mark_failure
    else
      status_line WARN "$label" "$detail"
    fi
    return
  fi

  cid="$(docker_compose ps -q "$service" 2>/dev/null | head -n 1 || true)"
  if [[ -z "$cid" ]]; then
    detail="compose_service=$service running=no"
  else
    inspection="$(docker inspect --format '{{.State.Status}}|{{.State.OOMKilled}}|{{.RestartCount}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}|{{.Config.Image}}' "$cid" 2>/dev/null || true)"
    IFS='|' read -r state oom restarts health image <<<"$inspection"
    detail="compose_service=$service state=${state:-unknown} health=${health:-unknown} oom=${oom:-unknown} restarts=${restarts:-unknown} image=${image:-unknown}"
  fi
  if [[ "$state" == "running" && "$oom" == "false" && "${restarts:-0}" == "0" && ( "$health" == "healthy" || "$health" == "none" ) ]]; then
    status_line OK "$label" "$detail"
  elif [[ "$required" == "required" ]]; then
    status_line FAIL "$label" "$detail"
    mark_failure
  else
    status_line WARN "$label" "$detail"
  fi
}

http_status() {
  local label="$1"
  local url="$2"
  local ok_codes="$3"
  local required="${4:-required}"
  shift 4 || true
  local code

  code="$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' --max-time 3 "$@" "$url" 2>/dev/null || true)"
  if [[ " $ok_codes " == *" ${code:-000} "* ]]; then
    status_line OK "$label" "http=$code"
  elif [[ "$required" == "required" ]]; then
    status_line FAIL "$label" "http=${code:-000}"
    mark_failure
  else
    status_line WARN "$label" "http=${code:-000}"
  fi
}

linear_webhook_public_readiness_status() {
  local label="$1"
  local required="${2:-required}"
  local public_port="${HATCHET_PUBLIC_LINEAR_WEBHOOK_FUNNEL_PORT:-443}"
  local dns url code detail

  if ! command -v tailscale >/dev/null 2>&1; then
    detail="tailscale command unavailable"
    if [[ "$required" == "required" ]]; then
      status_line FAIL "$label" "$detail"
      mark_failure
    else
      status_line WARN "$label" "$detail"
    fi
    return
  fi
  if ! command -v jq >/dev/null 2>&1; then
    detail="jq command unavailable"
    if [[ "$required" == "required" ]]; then
      status_line FAIL "$label" "$detail"
      mark_failure
    else
      status_line WARN "$label" "$detail"
    fi
    return
  fi

  dns="$(tailscale status --json 2>/dev/null | jq -r '.Self.DNSName // empty' 2>/dev/null | sed 's/[.]$//' || true)"
  if [[ -z "$dns" || "$dns" == "null" ]]; then
    detail="tailscale self DNS unavailable"
    if [[ "$required" == "required" ]]; then
      status_line FAIL "$label" "$detail"
      mark_failure
    else
      status_line WARN "$label" "$detail"
    fi
    return
  fi

  if [[ "$public_port" == "443" ]]; then
    url="https://$dns/ready"
  else
    url="https://$dns:$public_port/ready"
  fi
  code="$(curl --silent --show-error --insecure --output /dev/null --write-out '%{http_code}' --max-time 5 "$url" 2>/dev/null || true)"
  detail="http=${code:-000} url=$url"
  if [[ "${code:-000}" == "200" ]]; then
    status_line OK "$label" "$detail"
  elif [[ "$required" == "required" ]]; then
    status_line FAIL "$label" "$detail"
    mark_failure
  else
    status_line WARN "$label" "$detail"
  fi
}

bridge_token() {
  if [[ -r "$BRIDGE_ENV_FILE" ]]; then
    awk -F= '$1 == "HATCHET_HERMES_BRIDGE_TOKEN" { print $2; exit }' "$BRIDGE_ENV_FILE"
  fi
}

hatchet_conformance_status() {
  local script desired output critical warning
  script="$(factory_hatchet_doctor_script)"
  desired="$(factory_hatchet_desired_state)"
  if [[ ! -f "$script" || ! -f "$desired" || ! -x "$(command -v hatchet 2>/dev/null || true)" ]]; then
    status_line FAIL "Hatchet desired-state conformance" "doctor, desired state, or Hatchet CLI unavailable"
    mark_failure
    return
  fi
  output="$(python3 "$script" --desired "$desired" --profile "${FACTORY_HATCHET_PROFILE:-prod}" --json 2>/dev/null || true)"
  critical="$(jq -r '.criticalCount // empty' <<<"$output" 2>/dev/null || true)"
  warning="$(jq -r '.warningCount // empty' <<<"$output" 2>/dev/null || true)"
  if [[ ! "$critical" =~ ^[0-9]+$ || ! "$warning" =~ ^[0-9]+$ ]]; then
    status_line FAIL "Hatchet desired-state conformance" "inventory unavailable"
    mark_failure
  elif (( critical > 0 )); then
    status_line FAIL "Hatchet desired-state conformance" "critical=$critical warning=$warning"
    mark_failure
  elif (( warning > 0 )); then
    status_line WARN "Hatchet desired-state conformance" "critical=0 warning=$warning"
  else
    status_line OK "Hatchet desired-state conformance" "critical=0 warning=0"
  fi
}

bridge_reconciliation_status() {
  local token="$1" payload actionable critical warning terminal active system current historical
  payload="$(curl --silent --show-error --fail --max-time 3 -H "Authorization: Bearer $token" 'http://127.0.0.1:19877/reconciliation/findings?active_within_minutes=30' 2>/dev/null || true)"
  actionable="$(jq -r '.findings.actionable // empty' <<<"$payload" 2>/dev/null || true)"
  critical="$(jq -r '.findings.actionable_severity.critical // empty' <<<"$payload" 2>/dev/null || true)"
  warning="$(jq -r '.findings.actionable_severity.warning // empty' <<<"$payload" 2>/dev/null || true)"
  active="$(jq -r '.findings.scope.active_work // empty' <<<"$payload" 2>/dev/null || true)"
  system="$(jq -r '.findings.scope.system // empty' <<<"$payload" 2>/dev/null || true)"
  terminal="$(jq -r '.findings.scope.terminal_work // empty' <<<"$payload" 2>/dev/null || true)"
  current="$(jq -r '.findings.current // empty' <<<"$payload" 2>/dev/null || true)"
  historical="$(jq -r '.findings.historical // empty' <<<"$payload" 2>/dev/null || true)"
  if [[ ! "$actionable" =~ ^[0-9]+$ || ! "$critical" =~ ^[0-9]+$ || ! "$warning" =~ ^[0-9]+$ || ! "$active" =~ ^[0-9]+$ || ! "$system" =~ ^[0-9]+$ || ! "$terminal" =~ ^[0-9]+$ ]]; then
    status_line FAIL "Actionable reconciliation findings" "unavailable"
    mark_failure
  elif (( critical > 0 )); then
    status_line FAIL "Actionable reconciliation findings" "actionable=$actionable active=$active system=$system critical=$critical warning=$warning"
    mark_failure
  elif (( warning > 0 )); then
    status_line WARN "Actionable reconciliation findings" "actionable=$actionable active=$active system=$system critical=0 warning=$warning"
  else
    status_line OK "Actionable reconciliation findings" "actionable=0 active=0 system=0"
  fi
  if [[ "$terminal" =~ ^[0-9]+$ ]] && (( terminal > 0 )); then
    status_line WARN "Terminal reconciliation debt" "current=$terminal all_current=${current:-unknown} historical=${historical:-unknown}"
  elif [[ "$terminal" =~ ^[0-9]+$ ]]; then
    status_line OK "Terminal reconciliation debt" "current=0 historical=${historical:-unknown}"
  fi
}

lifecycle_writer_status() {
  local response code payload dead_letters dead_letter_reasons last_success
  response="$(curl --silent --show-error --max-time 3 --write-out $'\n%{http_code}' http://127.0.0.1:19880/status 2>/dev/null || true)"
  code="${response##*$'\n'}"
  payload="${response%$'\n'*}"
  dead_letters="$(jq -r '.outbox.dead_letters // empty' <<<"$payload" 2>/dev/null || true)"
  dead_letter_reasons="$(jq -c '.outbox.dead_letter_reasons // {}' <<<"$payload" 2>/dev/null || true)"
  last_success="$(jq -r '.last_success // empty' <<<"$payload" 2>/dev/null || true)"
  if [[ "$code" != "200" ]]; then
    status_line FAIL "Factory lifecycle writer status" "http=${code:-000} last_success=${last_success:-unknown}"
    mark_failure
  elif [[ "$dead_letters" =~ ^[0-9]+$ ]] && (( dead_letters > 0 )); then
    status_line WARN "Factory lifecycle writer status" "http=200 dead_letters=$dead_letters reasons=${dead_letter_reasons:-unknown} last_success=${last_success:-unknown}"
  else
    status_line OK "Factory lifecycle writer status" "http=200 dead_letters=${dead_letters:-0} last_success=${last_success:-unknown}"
  fi
}

factory_release_status() {
  local token="$1" cid labels version revision health_commit
  cid="$(docker_compose ps -q bridge 2>/dev/null | head -n 1 || true)"
  labels="$(docker inspect --format '{{index .Config.Labels "org.opencontainers.image.version"}}|{{index .Config.Labels "org.opencontainers.image.revision"}}' "$cid" 2>/dev/null || true)"
  IFS='|' read -r version revision <<<"$labels"
  health_commit="$(curl --silent --show-error --fail --max-time 3 -H "Authorization: Bearer $token" http://127.0.0.1:19877/health 2>/dev/null | jq -r '.release_commit // empty' 2>/dev/null || true)"
  if [[ -n "$revision" && "$revision" != "development-unversioned" && "$health_commit" == "$revision" ]]; then
    status_line OK "Factory release provenance" "version=${version:-unknown} commit=$revision"
  else
    status_line FAIL "Factory release provenance" "version=${version:-unknown} image_commit=${revision:-missing} bridge_commit=${health_commit:-missing}"
    mark_failure
  fi
}

command_status() {
  local label="$1"
  local required="${2:-required}"
  shift 2 || true

  if "$@" >/dev/null 2>&1; then
    status_line OK "$label" "$*"
  elif [[ "$required" == "required" ]]; then
    status_line FAIL "$label" "$*"
    mark_failure
  else
    status_line WARN "$label" "$*"
  fi
}

socket_status() {
  local label="$1"
  local socket="$2"
  local required="${3:-required}"

  if [[ -S "$socket" ]]; then
    status_line OK "$label" "$socket"
  elif [[ "$required" == "required" ]]; then
    status_line FAIL "$label" "missing $socket"
    mark_failure
  else
    status_line WARN "$label" "missing $socket"
  fi
}

