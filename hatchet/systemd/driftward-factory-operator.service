[Unit]
Description=Driftward Factory root-only retry operator
After=driftward-hatchet-bridge.service driftward-hatchet-event-ingress.service
Requires=driftward-hatchet-bridge.service driftward-hatchet-event-ingress.service
Documentation=file:/docker/driftward/hatchet/releases/bridge/current/README.md

[Service]
Type=exec
User=root
WorkingDirectory=/docker/driftward/hatchet/releases/bridge/current
Environment=PYTHONPATH=/docker/driftward/hatchet/releases/bridge/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HATCHET_INTAKE_ROUTING_REGISTRY_PATH=/etc/driftward/hatchet-routing-registry.json
Environment=HATCHET_VERIFIER_POLICY_PATH=/etc/driftward/hatchet-verifier-policy.json
EnvironmentFile=/etc/driftward/factory-operator.env
ExecStart=/usr/bin/python3 -m hatchet_hermes_bridge.cli serve-operator --socket /run/driftward-factory-operator/operator.sock
Restart=always
RestartSec=5
RuntimeDirectory=driftward-factory-operator
RuntimeDirectoryMode=0750
CPUQuota=10%
MemoryMax=96M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/driftward-hatchet-bridge /run/driftward-factory-operator
PrivateTmp=true

[Install]
WantedBy=multi-user.target
