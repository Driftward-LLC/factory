[Unit]
Description=Factory root-only retry operator
After=factory-hatchet-bridge.service factory-hatchet-event-ingress.service
Requires=factory-hatchet-bridge.service factory-hatchet-event-ingress.service
Documentation=file:/docker/factory/hatchet/releases/bridge/current/README.md

[Service]
Type=exec
User=root
WorkingDirectory=/docker/factory/hatchet/releases/bridge/current
Environment=PYTHONPATH=/docker/factory/hatchet/releases/bridge/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HATCHET_INTAKE_ROUTING_REGISTRY_PATH=/etc/factory/hatchet-routing-registry.json
Environment=HATCHET_VERIFIER_POLICY_PATH=/docker/factory/hatchet/releases/bridge/current/verifier-policy.json
EnvironmentFile=/etc/factory/factory-operator.env
ExecStart=/usr/bin/python3 -m hatchet_hermes_bridge.cli serve-operator --socket /run/factory-operator/operator.sock
Restart=always
RestartSec=5
RuntimeDirectory=factory-operator
RuntimeDirectoryMode=0750
CPUQuota=10%
MemoryMax=96M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/factory-hatchet-bridge /run/factory-operator
PrivateTmp=true

[Install]
WantedBy=multi-user.target
