[Unit]
Description=Factory Hatchet Hermes bridge ledger API
After=network-online.target
Wants=network-online.target
Documentation=file:/docker/factory/hatchet/releases/bridge/current/README.md

[Service]
Type=exec
WorkingDirectory=/docker/factory/hatchet/releases/bridge/current
Environment=PYTHONPATH=/docker/factory/hatchet/releases/bridge/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HATCHET_VERIFIER_POLICY_PATH=/docker/factory/hatchet/releases/bridge/current/verifier-policy.json
EnvironmentFile=-/etc/factory/hatchet-verifier.env
EnvironmentFile=-/etc/factory/hatchet-bridge.env
ExecStart=/usr/bin/python3 -m hatchet_hermes_bridge.cli --db /var/lib/factory-hatchet-bridge/bridge.db serve --host 127.0.0.1 --port 19877
Restart=always
RestartSec=5
RuntimeDirectory=factory-hatchet-bridge
CPUQuota=20%
MemoryMax=128M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/factory-hatchet-bridge
PrivateTmp=true

[Install]
WantedBy=multi-user.target
