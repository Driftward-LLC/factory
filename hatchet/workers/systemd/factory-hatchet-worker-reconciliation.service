[Unit]
Description=Factory Hatchet reconciliation worker
After=network-online.target factory-hatchet.service factory-hatchet-bridge.service factory-hatchet-event-ingress.service
Wants=network-online.target
Documentation=file:__REPO_ROOT__/hatchet/workers/reconciliation-worker/README.md

[Service]
Type=simple
WorkingDirectory=__REPO_ROOT__/hatchet/workers/reconciliation-worker
Environment=NODE_ENV=production
EnvironmentFile=/etc/factory/hatchet-workers.env
EnvironmentFile=-/etc/factory/hatchet-worker-reconciliation.env
ExecStart=/usr/bin/node dist/worker.js
Restart=always
RestartSec=5
CPUQuota=25%
MemoryMax=192M
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=multi-user.target
