[Unit]
Description=Factory Hatchet bridge executor worker
After=network-online.target factory-hatchet.service factory-hatchet-bridge.service factory-hermes.service factory-hatchet-hermes-gateway.service
Wants=network-online.target factory-hatchet-hermes-gateway.service
Documentation=file:__REPO_ROOT__/hatchet/workers/bridge-executor-worker/README.md

[Service]
Type=simple
WorkingDirectory=__REPO_ROOT__/hatchet/workers/bridge-executor-worker
Environment=NODE_ENV=production
EnvironmentFile=/etc/factory/hatchet-workers.env
EnvironmentFile=/etc/factory/hatchet-worker-bridge-executor.env
EnvironmentFile=-/etc/factory/hatchet-verifier.env
ExecStart=/usr/bin/node dist/worker.js
Restart=always
RestartSec=5
TimeoutStopSec=30
CPUQuota=50%
MemoryMax=256M
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=multi-user.target
