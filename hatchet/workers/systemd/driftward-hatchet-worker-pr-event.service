[Unit]
Description=Driftward Hatchet PR event worker
After=network-online.target driftward-hatchet.service
Wants=network-online.target
Documentation=file:__REPO_ROOT__/hatchet/workers/pr-event-worker/README.md

[Service]
Type=simple
WorkingDirectory=__REPO_ROOT__/hatchet/workers/pr-event-worker
Environment=NODE_ENV=production
EnvironmentFile=/etc/driftward/hatchet-workers.env
ExecStart=/usr/bin/node dist/worker.js
Restart=always
RestartSec=5
CPUQuota=25%
MemoryMax=192M
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=multi-user.target
