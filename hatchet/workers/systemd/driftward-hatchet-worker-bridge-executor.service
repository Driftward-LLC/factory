[Unit]
Description=Driftward Hatchet bridge executor worker
After=network-online.target driftward-hatchet.service driftward-hatchet-bridge.service driftward-hermes.service
Wants=network-online.target
Documentation=file:__REPO_ROOT__/hatchet/workers/bridge-executor-worker/README.md

[Service]
Type=simple
WorkingDirectory=__REPO_ROOT__/hatchet/workers/bridge-executor-worker
Environment=NODE_ENV=production
EnvironmentFile=/etc/driftward/hatchet-workers.env
EnvironmentFile=/etc/driftward/hatchet-worker-bridge-executor.env
EnvironmentFile=-/etc/driftward/hatchet-verifier.env
ExecStart=/usr/bin/node dist/worker.js
Restart=always
RestartSec=5
TimeoutStopSec=30
CPUQuota=50%
MemoryMax=256M
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=multi-user.target
