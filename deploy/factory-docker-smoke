#!/usr/bin/env bash
set -euo pipefail

runtime_root="${1:-${DRIFTWARD_FACTORY_RUNTIME_ROOT:-/docker/driftward/factory}}"
hatchet_env_file="${DRIFTWARD_HATCHET_ENV_FILE:-/etc/driftward/hatchet.env}"
bridge_env_file="${FACTORY_HATCHET_BRIDGE_ENV:-/etc/driftward/hatchet-bridge.env}"
operator_env_file="${FACTORY_OPERATOR_ENV:-/etc/driftward/factory-operator.env}"
operator_socket="${FACTORY_OPERATOR_SOCKET:-/run/driftward-factory-operator/operator.sock}"
operator_preview_smoke_issue="${FACTORY_OPERATOR_PREVIEW_SMOKE_ISSUE:-ENG-999999999}"
expected_policy_path="/app/hatchet/workers/verifier-policy.json"
hatchet_postgres_volume=driftward-factory-hatchet-postgres-data
hatchet_config_volume=driftward-factory-hatchet-config-data
bridge_volume=driftward-factory-bridge-data
ingress_volume=driftward-factory-ingress-data
lifecycle_volume=driftward-factory-lifecycle-data
linear_token_volume=driftward-factory-linear-token-data

env_file_value() {
  local file="$1"
  local key="$2"
  [[ -r "$file" ]] || return 1
  awk -F= -v key="$key" '$1 == key { print substr($0, length(key) + 2); exit }' "$file"
}

strip_simple_quotes() {
  local value="$1"
  value="${value%\"}"; value="${value#\"}"
  value="${value%\'}"; value="${value#\'}"
  printf '%s\n' "$value"
}

if [[ ! -f "$runtime_root/docker-compose.yml" ]]; then
  echo "Factory compose file is missing: $runtime_root/docker-compose.yml" >&2
  exit 1
fi

compose_args=(--project-directory "$runtime_root")
if [[ -r "$hatchet_env_file" ]]; then
  compose_args=(--env-file "$hatchet_env_file" "${compose_args[@]}")
fi

required_services=(
  postgres
  hatchet-lite
  bridge
  event-ingress
  linear-webhook-proxy
  intake-worker
  execution-dispatch-worker
  bridge-executor-worker
  pr-event-worker
  reconciliation-worker
  factory-lifecycle-writer
  factory-linear-token-refresh
  factory-operator
  outbox-dispatcher
)

running="$(docker compose "${compose_args[@]}" ps --services --filter status=running)"
for service in "${required_services[@]}"; do
  if ! grep -qx "$service" <<<"$running"; then
    echo "Factory Docker service is not running: $service" >&2
    exit 1
  fi
done

require_container_health() {
  local service="$1" cid inspection state oom restarts health
  cid="$(docker compose "${compose_args[@]}" ps -q "$service")"
  inspection="$(docker inspect --format '{{.State.Status}}|{{.State.OOMKilled}}|{{.RestartCount}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$cid")"
  IFS='|' read -r state oom restarts health <<<"$inspection"
  if [[ "$state" != "running" || "$oom" != "false" || "$restarts" != "0" || ( "$health" != "healthy" && "$health" != "none" ) ]]; then
    echo "Factory Docker service is degraded: $service state=$state health=$health oom=$oom restarts=$restarts" >&2
    exit 1
  fi
}

for service in "${required_services[@]}"; do
  require_container_health "$service"
done

require_named_volume_mount() {
  local service="$1"
  local destination="$2"
  local expected="$3"
  local cid mount

  cid="$(docker compose "${compose_args[@]}" ps -q "$service")"
  if [[ -z "$cid" ]]; then
    echo "Factory Docker service has no container id: $service" >&2
    exit 1
  fi
  mount="$(
    docker inspect --format '{{range .Mounts}}{{printf "%s\t%s\t%s\n" .Type .Name .Destination}}{{end}}' "$cid" |
      awk -F '\t' -v dest="$destination" '$3 == dest { print $1 " " $2; found=1 } END { exit found ? 0 : 1 }'
  )" || {
    echo "Factory Docker service $service is missing mount: $destination" >&2
    exit 1
  }
  if [[ "$mount" != "volume $expected" ]]; then
    echo "Factory Docker service $service has unexpected mount for $destination: $mount" >&2
    exit 1
  fi
}

require_named_volume_mount postgres /var/lib/postgresql/data "$hatchet_postgres_volume"
require_named_volume_mount hatchet-lite /config "$hatchet_config_volume"
require_named_volume_mount bridge /var/lib/driftward-hatchet-bridge "$bridge_volume"
require_named_volume_mount event-ingress /var/lib/driftward-hatchet-event-ingress "$ingress_volume"
require_named_volume_mount factory-lifecycle-writer /var/lib/driftward-factory-lifecycle-writer "$lifecycle_volume"
require_named_volume_mount factory-linear-token-refresh /var/lib/driftward-factory-linear-token "$linear_token_volume"
require_named_volume_mount factory-operator /var/lib/driftward-hatchet-bridge "$bridge_volume"
require_named_volume_mount factory-operator /var/lib/driftward-hatchet-event-ingress "$ingress_volume"
require_named_volume_mount outbox-dispatcher /var/lib/driftward-hatchet-bridge "$bridge_volume"
require_named_volume_mount outbox-dispatcher /var/lib/driftward-hatchet-event-ingress "$ingress_volume"

for service in bridge intake-worker bridge-executor-worker factory-operator; do
  runtime="$(docker compose "${compose_args[@]}" exec -T "$service" printenv HATCHET_FACTORY_RUNTIME || true)"
  if [[ "$runtime" != "docker" ]]; then
    echo "Factory Docker service $service has unexpected runtime marker: $runtime" >&2
    exit 1
  fi
  actual="$(docker compose "${compose_args[@]}" exec -T "$service" printenv HATCHET_VERIFIER_POLICY_PATH || true)"
  if [[ "$actual" != "$expected_policy_path" ]]; then
    echo "Factory Docker service $service has unexpected verifier policy path: $actual" >&2
    exit 1
  fi
done

bridge_header=()
if [[ -r "$bridge_env_file" ]]; then
  token="$(env_file_value "$bridge_env_file" HATCHET_HERMES_BRIDGE_TOKEN || true)"
  token="$(strip_simple_quotes "$token")"
  if [[ -n "${token:-}" ]]; then
    bridge_header=(-H "Authorization: Bearer $token")
  fi
fi

operator_preview_smoke() {
  local token response status payload error

  if [[ ! "$operator_preview_smoke_issue" =~ ^ENG-[1-9][0-9]*$ ]]; then
    echo "Factory operator preview smoke issue must be an ENG identifier" >&2
    exit 1
  fi
  if [[ ! -r "$operator_env_file" ]]; then
    echo "Factory operator env file is missing: $operator_env_file" >&2
    exit 1
  fi
  if [[ ! -S "$operator_socket" ]]; then
    echo "Factory operator socket is missing: $operator_socket" >&2
    exit 1
  fi

  token="$(env_file_value "$operator_env_file" HATCHET_FACTORY_OPERATOR_TOKEN || true)"
  token="$(strip_simple_quotes "$token")"
  if [[ -z "${token:-}" ]]; then
    echo "Factory operator token is missing from $operator_env_file" >&2
    exit 1
  fi

  response="$(
    curl --silent --show-error --unix-socket "$operator_socket" \
      -H "Authorization: Bearer $token" \
      -H 'Content-Type: application/json' \
      --data "{\"issue\":\"$operator_preview_smoke_issue\"}" \
      --write-out '\n%{http_code}' \
      http://localhost/v1/retry/preview
  )"
  status="${response##*$'\n'}"
  payload="${response%$'\n'*}"
  if [[ ! "$status" =~ ^[0-9]{3}$ ]]; then
    echo "Factory operator preview smoke returned an invalid HTTP status" >&2
    exit 1
  fi
  error="$(
    python3 -c 'import json,sys; value=json.load(sys.stdin); print(value.get("error",""))' <<<"$payload"
  )" || {
    echo "Factory operator preview smoke did not return JSON" >&2
    exit 1
  }
  if [[ "$status" == "401" ]]; then
    echo "Factory operator preview smoke was unauthorized" >&2
    exit 1
  fi
  if [[ "$error" == "trusted_ingress_unavailable" ]]; then
    echo "Factory operator preview smoke cannot read trusted ingress" >&2
    exit 1
  fi
  if [[ "$status" != "200" && -z "$error" ]]; then
    echo "Factory operator preview smoke returned HTTP $status without a bounded error" >&2
    exit 1
  fi
}

hatchet_postgres_db="$(strip_simple_quotes "$(env_file_value "$hatchet_env_file" HATCHET_POSTGRES_DB || true)")"
hatchet_postgres_user="$(strip_simple_quotes "$(env_file_value "$hatchet_env_file" HATCHET_POSTGRES_USER || true)")"
hatchet_postgres_db="${hatchet_postgres_db:-hatchet}"
hatchet_postgres_user="${hatchet_postgres_user:-hatchet}"

docker compose "${compose_args[@]}" exec -T postgres pg_isready \
  -d "$hatchet_postgres_db" \
  -U "$hatchet_postgres_user" >/dev/null
curl -fsS http://127.0.0.1:8733/ready >/dev/null

bridge_health="$(curl -fsS "${bridge_header[@]}" http://127.0.0.1:19877/health)"
bridge_cid="$(docker compose "${compose_args[@]}" ps -q bridge)"
image_revision="$(docker inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$bridge_cid")"
bridge_revision="$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("release_commit", ""))' <<<"$bridge_health")"
if [[ -z "$image_revision" || "$image_revision" == "development-unversioned" || "$bridge_revision" != "$image_revision" ]]; then
  echo "Factory release provenance mismatch: image=${image_revision:-missing} bridge=${bridge_revision:-missing}" >&2
  exit 1
fi
curl -fsS http://127.0.0.1:19878/health >/dev/null
curl -fsS http://127.0.0.1:19879/health >/dev/null
curl -fsS http://127.0.0.1:19880/health >/dev/null
curl -fsS http://127.0.0.1:19881/health >/dev/null
operator_preview_smoke
factory doctor hatchet --profile "${FACTORY_HATCHET_PROFILE:-prod}" --json >/dev/null

echo "Factory Docker runtime is healthy: $runtime_root"
