[Unit]
Description=Factory Hermes Factory gRPC gateway
Requires=docker.service
After=docker.service network-online.target factory-hermes.service
Wants=network-online.target factory-hermes.service
Documentation=file:__SOURCE_ROOT__/deploy/README.md

[Service]
Type=simple
RuntimeDirectory=factory-hermes-factory
RuntimeDirectoryPreserve=yes
WorkingDirectory=__FACTORY_SHARE_DIR__/hermes-gateway
Environment=NODE_ENV=production
Environment=FACTORY_ORGANIZATION_CONFIG=/etc/factory/factory/organization.json
Environment=HATCHET_VERIFIER_POLICY_PATH=/etc/factory/factory/verifier-policy.json
Environment=HATCHET_INDEPENDENT_REVIEW_POLICY_PATH=/etc/factory/factory/independent-review-policy.json
Environment=FACTORY_HERMES_GRPC_TARGET=unix:///run/factory-hermes-factory/hermes.sock
EnvironmentFile=-/etc/factory/hatchet-worker-bridge-executor.env
ExecStartPre=/bin/sh -c 'group=factory; getent group "$group" >/dev/null || group=root; install -d -m 2770 -o root -g "$group" /run/factory-hermes-factory'
ExecStart=__NODE_BIN__ __FACTORY_SHARE_DIR__/hermes-gateway/hermes-gateway-server.js
Restart=always
RestartSec=5
TimeoutStopSec=30
CPUQuota=50%
MemoryMax=384M
UMask=0007
StateDirectory=factory-hermes-factory
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/run/factory-hermes-factory /var/lib/factory-hermes-factory /var/lib/factory-reviewer /run/docker.sock /var/run/docker.sock

[Install]
WantedBy=multi-user.target
