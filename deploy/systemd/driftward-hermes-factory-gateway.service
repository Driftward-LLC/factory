[Unit]
Description=Driftward Hermes Factory gRPC gateway
Requires=docker.service
After=docker.service network-online.target driftward-hermes.service
Wants=network-online.target driftward-hermes.service
Documentation=file:__SOURCE_ROOT__/deploy/README.md

[Service]
Type=simple
WorkingDirectory=__FACTORY_SHARE_DIR__/hermes-gateway
Environment=NODE_ENV=production
Environment=HATCHET_VERIFIER_POLICY_PATH=__FACTORY_SHARE_DIR__/verifier-policy.json
Environment=DRIFTWARD_HERMES_GRPC_TARGET=unix:///run/driftward-hermes-factory/hermes.sock
EnvironmentFile=-/etc/driftward/hatchet-worker-bridge-executor.env
ExecStartPre=/bin/sh -c 'group=driftward; getent group "$group" >/dev/null || group=root; install -d -m 2770 -o root -g "$group" /run/driftward-hermes-factory'
ExecStart=__NODE_BIN__ __FACTORY_SHARE_DIR__/hermes-gateway/hermes-gateway-server.js
Restart=always
RestartSec=5
TimeoutStopSec=30
CPUQuota=50%
MemoryMax=384M
UMask=0007
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/run/driftward-hermes-factory /run/docker.sock /var/run/docker.sock

[Install]
WantedBy=multi-user.target
