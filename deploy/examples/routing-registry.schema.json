{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "routes"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "project_id",
          "repo",
          "execution_enabled"
        ],
        "properties": {
          "project_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
          },
          "repo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "execution_enabled": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
