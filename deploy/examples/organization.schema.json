{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory-organization-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "linear",
    "github"
  ],
  "properties": {
    "schema": {
      "const": "factory-organization-v1"
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "linear": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workspace_id",
            "team_id",
            "team_key",
            "workspace_slug",
            "actor_id",
            "delegate_name"
          ],
          "properties": {
            "workspace_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
            },
            "team_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
            },
            "actor_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
            },
            "team_key": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]{0,15}$"
            },
            "workspace_slug": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
            },
            "delegate_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^\\S(?:[^\\u0000-\\u001f]*\\S)?$"
            }
          }
        }
      ]
    }
  }
}
